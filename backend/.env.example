# Copy to .env for local dev / seeding. Never commit .env.
# In Lambda, AWS_REGION is set automatically (it is a reserved variable there).
AWS_REGION=us-east-1
DYNAMODB_USERS_TABLE=radius-users
DYNAMODB_PROJECTS_TABLE=radius-projects
DYNAMODB_REQUESTS_TABLE=radius-requests
DYNAMODB_TEAMS_TABLE=radius-teams
S3_BUCKET=
# Leave empty to use the DynamoDB fallback search.
OPENSEARCH_ENDPOINT=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Set to false to skip Bedrock and use the deterministic fallbacks.
BEDROCK_ENABLED=true
CORS_ORIGIN=*
PORT=4000

# Amazon Cognito user pool that signs people in (Step: Cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
