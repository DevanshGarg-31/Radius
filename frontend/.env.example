# URL of the Radius API (API Gateway invoke URL, or the local dev server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Amazon Cognito (see docs): user pool, web app client and the managed login domain
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
# Team-room WebSocket (wss://...), empty = chat refreshes every few seconds
NEXT_PUBLIC_WS_URL=
